# --- WalletConnect / Reown project id (required by RainbowKit) ---
# Get one free at https://dashboard.reown.com (formerly cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# --- Canonical production host used for SIWE domain checks ---
APP_HOST=botanica.bombolabs.xyz

# --- Server session secret for iron-session (>= 32 chars) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=replace_with_a_long_random_string_at_least_32_chars

# --- Berachain RPC (read-only NFT lookups) ---
BERACHAIN_RPC_URL=https://rpc.berachain.com

# --- IPFS gateway (assets are pinned on Pinata) ---
# Strongly recommended: use your OWN dedicated Pinata gateway for speed, e.g.
# https://your-subdomain.mypinata.cloud/ipfs/
# Falls back to the shared (rate-limited) Pinata gateway if unset.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
